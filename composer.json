{
	"name": "soderlind/ai-provider-for-jev",
	"description": "Connect WordPress to TypeSafe's Jev System One model for structured decisions.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.3"
	},
	"require-dev": {
		"brain/monkey": "^2.7",
		"pestphp/pest": "^5.0"
	},
	"autoload": {
		"psr-4": {
			"AiProviderForJev\\": "src/"
		}
	},
	"scripts": {
		"test": "pest",
		"test:coverage": "pest --coverage"
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"allow-plugins": {
			"pestphp/pest-plugin": true
		}
	}
}
